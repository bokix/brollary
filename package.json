{
  "name": "brollary",
  "version": "0.1.0",
  "private": true,
  "productName": "Brollary",
  "description": "Brollary（空镜库）— 本地优先的素材库管理器。JSON 为权威源，SQLite/FTS5 是可重建索引。工作代号 stash，已定名 Brollary。",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "stash": "./src/cli.ts"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bokix/brollary.git"
  },
  "author": "bokix",
  "keywords": [
    "brollary",
    "asset-library",
    "electron",
    "media-manager",
    "digital-asset-management"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
